{
    "require": [
        "{{{1200128_anodosys}}}/webserver_php_magento-module-demo.json",
        "{{{1200128_anodosys}}}/database_magento2-module-demo.json",
        "{{{1200128_anodosys}}}/elasticsearch_magento-module-demo.json",
        "{{{1200128_anodosys}}}/mailcatcher_magento.json",
        "{{{1200128_anodosys}}}/magento2-module-demo.json",
        "{credentials}/1200128_anodosys/add-hyva-theme.json"
    ],
    "extensions": {
        "1200128_anodosys": "dev"
    },
    "global": {
        "systemName": "infrangible_m2_retail_store_hyva"
    },
    "ws": {
        "webServerType": "apache_php",
        "webServerVersion": "2.4",
        "phpVersion": "8.2",
        "containerVolumes": [
            "{configPath}/../src:/var/www/magento/htdocs/app/code/Infrangible/RetailStoreHyva:www-data"
        ],
        "beforeContainerInstallDockerScript": "{{{{1200128_anodosys}}}}/docker/add-hyva-theme.sh",
        "beforeContainerInstallDockerParameters": [
            "--hyvaToken {hyvaToken}",
            "--hyvaRepositoryUrl {hyvaRepositoryUrl}"
        ],
        "beforeContainerInstallDockerUser": "{webServerUser}"
    },
    "db": {
        "databaseType": "mysql",
        "databaseVersion": "5.7"
    },
    "es": {
        "elasticsearchVersion": "7.9"
    },
    "mc": {
        "mailCatcherVersion": "0.6"
    },
    "ms": {
        "magentoVersion": "2.4.6-p3",
        "magentoEdition": "community"
    }
}
